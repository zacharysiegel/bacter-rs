# Production server settings for the host behind the Cloudflare Tunnel, which terminates TLS.

BACTER_BIND_ADDRESS=127.0.0.1
BACTER_PORT=12001
BACTER_SITE_ROOT=target/site

# Comma-separated page origins allowed to open /ws.
BACTER_ALLOWED_ORIGINS="https://<public hostname>"

# cloudflared on this machine.
BACTER_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1

RUST_LOG=info
